##### SERVER #####
# Requires LNbits server and the Bitcoin Switch Extension.
# GPIO number and duration are defined there.
BITCOIN_SWITCH_WS=wss://send.laisee.org/api/v1/ws/WB4kjkTtQRVWdSL7FeV6b3

# The LNURL provided by the Bitcoin Switch extension
LNURL=lightning:LNURL1DP68GURN8GHJ7UM9DEJZUMRPD9EK2EFWDAEXWTMZD96XXMMFDEEHW6T5VD5Z7CTSDYHHVVF0D3H82UNV9AT5YDRTDF44GAZ32FT9WEZNFSM5VE2KXE3RX0MSD9HR6DG35NGRL

# Pins used by display (BCM): 3.3V, 10, 11, 8, 25, 17, 24

PRICE=1
CURRENCY=CAD

##### SYSTEM CONFIGURATION ##### (optional)

# DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG_LEVEL=DEBUG # Default: INFO
PRODUCTION=FALSE

#DISPLAY_DELAY=1 # Time in seconds that the display needs to refres. Used to extend the lifetime of the Lightning invoice. Default: 1
#SUCCESS_SCREEN_EXPIRY=5 # The time that the success or failure screen is shown. Affects the listening cycle. Default: 5
#RELAY_DURATION=500 # Time in milli-seconds that the machine will trigger the relay. If set too high, multiple sodas may be dispensed. Default: 500

##### DISPLAY #####

SHOWDISPLAY=TRUE

FONTA=Font.ttc #The file name of the font to be used. Must be placed in the /pic directory
FONTSIZEA=24 #The size of the font to be used

FONTB=Rushfordclean.otf
FONTSIZEB=32 #The size of the alternative font to be used
